<View>
  <Header value="Anote as entidades e seus atributos:"/>
  
  <Text name="text" value="$text"/>
  
  <!-- Spans para anotação de entidades -->
  <Labels name="entities" toName="text">
    <Label value="TEMPO" background="#1890ff" />
    <Label value="VALOR" background="#f5222d" />
    <Label value="PAGAMENTO" background="#52c41a" />
    <Label value="CONDIÇÃO" background="#fa8c16" />
  </Labels>
  
  <!-- Categorias de atributos para entidades -->
  <Relations>
    <Relation value="tem_orientacao" />
    <Relation value="tem_modalidade" />
    <Relation value="tem_referencia_temporal" />
    <Relation value="tem_explicitude" />
    <Relation value="tem_acao" />
  </Relations>
  
  <!-- Classificações dos atributos -->
  <Labels name="orientacao" toName="text">
    <Label value="positiva" background="#52c41a" />
    <Label value="negativa" background="#f5222d" />
    <Label value="neutra" background="#d9d9d9" />
  </Labels>
  
  <Labels name="modalidade" toName="text">
    <Label value="afirmado" background="#52c41a" />
    <Label value="planejado" background="#1890ff" />
    <Label value="incerto" background="#722ed1" />
    <Label value="negado" background="#f5222d" />
    <Label value="condicional" background="#fa8c16" />
  </Labels>
  
  <Labels name="referencia_temporal" toName="text">
    <Label value="presente" background="#52c41a" />
    
    <Label value="passado" background="#fa8c16" />
    <Label value="futuro" background="#1890ff" />
  </Labels>
  
  <Labels name="explicitude" toName="text">
    <Label value="explicito" background="#52c41a" />
    <Label value="implicito" background="#f5222d" />
  </Labels>
  

</View>